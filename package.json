{
  "name": "ballnik",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "test": "node --disable-warning=ExperimentalWarning --test tests/*.test.mjs",
    "test:python": "python3 -m unittest discover -s tests/python -v",
    "test:smoke": "python3 scripts/smoke_local.py",
    "typecheck": "tsc --noEmit",
    "validate:data": "python3 -m pipeline.validate",
    "audit": "python3 -m pipeline.audit",
    "check": "npm run typecheck && npm test && npm run test:python && npm run validate:data",
    "dev": "wrangler dev --local --ip 127.0.0.1 --port 8787 --inspector-port 0",
    "deploy:dry": "wrangler deploy --dry-run --outdir build",
    "deploy": "wrangler deploy",
    "db:local": "wrangler d1 migrations apply ballnik --local",
    "db:remote": "wrangler d1 migrations apply ballnik --remote",
    "data:fetch": "python3 -m pipeline.mephi_pipeline fetch",
    "data:build": "python3 -m pipeline.mephi_pipeline build",
    "data:validate": "python3 -m pipeline.mephi_pipeline validate",
    "data:export": "python3 -m pipeline.import_mephi --export-sql data/normalized/mephi/import.sql",
    "research:build": "python3 -m pipeline.competition_research build",
    "research:validate": "python3 -m pipeline.competition_research validate",
    "bot:check": "python3 scripts/local_bot.py --check",
    "bot:local": "python3 scripts/local_bot.py",
    "catalog:build": "python3 -m pipeline.catalog_pipeline build",
    "catalog:validate": "python3 -m pipeline.catalog_pipeline validate"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "wrangler": "4.152.0"
  }
}
